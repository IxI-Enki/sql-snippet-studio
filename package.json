{
  "name": "sql-snippet-studio",
  "displayName": "SQL Snippet Studio",
  "description": "Offline SQL snippets and IntelliSense for PostgreSQL and Oracle PL/SQL with optional local LLM assistance.",
  "version": "2.0.0",
  "publisher": "dbi-team",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "postgresql",
    "oracle",
    "plsql",
    "database",
    "snippets",
    "dbi",
    "offline"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql",
    "onLanguage:plsql",
    "onCommand:dbiSurvivalKit.queryLLM",
    "onCommand:dbiSurvivalKit.showLLMStats",
    "onCommand:dbiSurvivalKit.clearCache",
    "onCommand:dbiSurvivalKit.insertStarSchema",
    "onCommand:dbiSurvivalKit.insertDimensionTable",
    "onCommand:dbiSurvivalKit.insertFactTable"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": ["SQL", "sql"],
        "extensions": [".sql", ".ddl", ".dml"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plsql",
        "aliases": ["PL/SQL", "plsql"],
        "extensions": [".pls", ".plsql"],
        "configuration": "./language-configuration.json"
      }
    ],
  "snippets": [
    {
      "language": "sql",
      "path": "./snippets/postgres-snippets.json"
    },
    {
      "language": "sql",
      "path": "./snippets/oracle-snippets.json"
    },
    {
      "language": "sql",
      "path": "./snippets/shared-snippets.json"
    },
    {
      "language": "plsql",
      "path": "./snippets/oracle-snippets.json"
    },
    {
      "language": "plsql",
      "path": "./snippets/shared-snippets.json"
    }
  ],
    "configuration": {
      "title": "SQL Snippet Studio",
      "properties": {
        "sqlSnippetStudio.enableAutoCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic completion suggestions"
        },
        "sqlSnippetStudio.enableStarSchemaTemplates": {
          "type": "boolean",
          "default": true,
          "description": "Enable Star-Schema templates and patterns"
        },
        "sqlSnippetStudio.databaseDialect": {
          "type": "string",
          "enum": ["postgres", "oracle", "both"],
          "default": "both",
          "description": "Select database dialect for snippets"
        },
        "sqlSnippetStudio.llm.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI-powered query suggestions (requires local LLM or API)"
        },
        "sqlSnippetStudio.llm.endpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1/chat/completions",
          "description": "LLM API endpoint (OpenAI-compatible format)"
        },
        "sqlSnippetStudio.llm.model": {
          "type": "string",
          "default": "qwen2.5-coder",
          "description": "Model name to use for completions"
        },
        "sqlSnippetStudio.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for LLM service (leave empty for local LLMs)"
        },
        "sqlSnippetStudio.llm.maxTokens": {
          "type": "number",
          "default": 500,
          "description": "Maximum tokens for LLM response"
        },
        "sqlSnippetStudio.llm.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for LLM sampling (lower = more deterministic)"
        },
        "sqlSnippetStudio.llm.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Request timeout in milliseconds"
        },
        "sqlSnippetStudio.llm.showDebugInfo": {
          "type": "boolean",
          "default": false,
          "description": "Show debug information (status bar, labels in completions)"
        },
        "sqlSnippetStudio.llm.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show toast notifications for LLM requests"
        },
        "sqlSnippetStudio.llm.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging to output channel"
        }
      }
    },
    "commands": [
      {
        "command": "dbiSurvivalKit.insertStarSchema",
        "title": "SQL: Insert Star Schema Template"
      },
      {
        "command": "dbiSurvivalKit.insertDimensionTable",
        "title": "SQL: Insert Dimension Table"
      },
      {
        "command": "dbiSurvivalKit.insertFactTable",
        "title": "SQL: Insert Fact Table"
      },
      {
        "command": "dbiSurvivalKit.shareSnippets",
        "title": "SQL: Export Snippets"
      },
      {
        "command": "dbiSurvivalKit.importSnippets",
        "title": "SQL: Import Snippets"
      },
      {
        "command": "dbiSurvivalKit.showLLMStats",
        "title": "SQL: Show LLM Statistics"
      },
            {
              "command": "dbiSurvivalKit.clearCache",
              "title": "SQL: Clear LLM Cache"
            },
            {
              "command": "dbiSurvivalKit.queryLLM",
              "title": "SQL: Query LLM for SQL Solution"
            }
    ],
    "keybindings": [
      {
        "command": "dbiSurvivalKit.insertStarSchema",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "dbiSurvivalKit.insertDimensionTable",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "dbiSurvivalKit.insertFactTable",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "dbiSurvivalKit.showLLMStats",
        "key": "ctrl+alt+shift+l",
        "mac": "cmd+alt+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "dbiSurvivalKit.queryLLM",
        "key": "ctrl+alt+shift+q",
        "mac": "cmd+alt+shift+q",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "install-local": "code --install-extension sql-snippet-studio-2.0.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IxI-Enki/sql-snippet-studio"
  }
}
