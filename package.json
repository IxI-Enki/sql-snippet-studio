{
  "name": "sql-snippet-studio",
  "displayName": "SQL Snippet Studio",
  "description": "Offline SQL snippets and IntelliSense for PostgreSQL and Oracle PL/SQL with optional local LLM assistance.",
  "version": "2.0.1",
  "publisher": "IxI-Enki",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1a2332",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "postgresql",
    "oracle",
    "plsql",
    "database",
    "snippets",
    "dbi",
    "offline"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql",
    "onLanguage:plsql",
    "onCommand:sqlSnippetStudio.queryLLM",
    "onCommand:sqlSnippetStudio.showLLMStats",
    "onCommand:sqlSnippetStudio.clearCache",
    "onCommand:sqlSnippetStudio.setLlmApiToken",
    "onCommand:sqlSnippetStudio.clearLlmApiToken",
    "onCommand:sqlSnippetStudio.testLlmConnection",
    "onCommand:sqlSnippetStudio.insertStarSchema",
    "onCommand:sqlSnippetStudio.insertDimensionTable",
    "onCommand:sqlSnippetStudio.insertFactTable"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": [
          "SQL",
          "sql"
        ],
        "extensions": [
          ".sql",
          ".ddl",
          ".dml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plsql",
        "aliases": [
          "PL/SQL",
          "plsql"
        ],
        "extensions": [
          ".pls",
          ".plsql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "sql",
        "path": "./snippets/postgres-snippets.json"
      },
      {
        "language": "sql",
        "path": "./snippets/oracle-snippets.json"
      },
      {
        "language": "sql",
        "path": "./snippets/shared-snippets.json"
      },
      {
        "language": "plsql",
        "path": "./snippets/oracle-snippets.json"
      },
      {
        "language": "plsql",
        "path": "./snippets/shared-snippets.json"
      }
    ],
    "configuration": {
      "title": "SQL Snippet Studio",
      "properties": {
        "sqlSnippetStudio.llm.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI-powered query suggestions (requires local LLM or API)"
        },
        "sqlSnippetStudio.llm.endpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1/chat/completions",
          "description": "LLM API endpoint (OpenAI-compatible format)"
        },
        "sqlSnippetStudio.llm.model": {
          "type": "string",
          "default": "qwen2.5-coder-32b-instruct",
          "description": "Model identifier loaded in LM Studio or your API provider"
        },
        "sqlSnippetStudio.llm.maxTokens": {
          "type": "number",
          "default": 500,
          "description": "Maximum tokens for LLM response"
        },
        "sqlSnippetStudio.llm.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for LLM sampling (lower = more deterministic)"
        },
        "sqlSnippetStudio.llm.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Request timeout in milliseconds"
        },
        "sqlSnippetStudio.llm.autoCompletion": {
          "type": "boolean",
          "default": false,
          "description": "Automatically query the LLM while typing after task comments (manual Ctrl+Alt+Shift+Q remains the default workflow)"
        },
        "sqlSnippetStudio.llm.showDebugInfo": {
          "type": "boolean",
          "default": false,
          "description": "Show debug information (status bar, labels in completions)"
        },
        "sqlSnippetStudio.llm.showNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show toast notifications for LLM requests"
        },
        "sqlSnippetStudio.llm.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging to output channel"
        }
      }
    },
    "commands": [
      {
        "command": "sqlSnippetStudio.insertStarSchema",
        "title": "SQL: Insert Star Schema Template"
      },
      {
        "command": "sqlSnippetStudio.insertDimensionTable",
        "title": "SQL: Insert Dimension Table"
      },
      {
        "command": "sqlSnippetStudio.insertFactTable",
        "title": "SQL: Insert Fact Table"
      },
      {
        "command": "sqlSnippetStudio.showLLMStats",
        "title": "SQL: Show LLM Statistics"
      },
      {
        "command": "sqlSnippetStudio.clearCache",
        "title": "SQL: Clear LLM Cache"
      },
      {
        "command": "sqlSnippetStudio.queryLLM",
        "title": "SQL: Query LLM for SQL Solution"
      },
      {
        "command": "sqlSnippetStudio.setLlmApiToken",
        "title": "SQL: Set LLM API Token"
      },
      {
        "command": "sqlSnippetStudio.clearLlmApiToken",
        "title": "SQL: Clear LLM API Token"
      },
      {
        "command": "sqlSnippetStudio.testLlmConnection",
        "title": "SQL: Test LLM Connection"
      }
    ],
    "keybindings": [
      {
        "command": "sqlSnippetStudio.insertStarSchema",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "sqlSnippetStudio.insertDimensionTable",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "sqlSnippetStudio.insertFactTable",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "sqlSnippetStudio.showLLMStats",
        "key": "ctrl+alt+shift+l",
        "mac": "cmd+alt+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "sqlSnippetStudio.queryLLM",
        "key": "ctrl+alt+shift+q",
        "mac": "cmd+alt+shift+q",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "install-local": "code --install-extension current_version/sql-snippet-studio-2.0.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "3.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IxI-Enki/sql-snippet-studio"
  }
}
