# =============================================================================
# SQL Snippet Studio — .gitignore
# Public repo: README + docs/guides only. Internal paths below stay local.
# =============================================================================

# --- Dependencies ---
node_modules/

# --- Build / packaging ---
*.vsix
!current_version/*.vsix
*.tgz
.dist/
out/

# --- Secrets / environment ---
.env
.env.*
!.env.example
credentials.json
*.pem

# --- Local dev / QA (never version) ---
test/*
!test/*.test.js
.archived_versions/
bug-fixes/
scriptfiles-probably-all-obsolete/

# --- Tooling / AI workspace ---
.cache/
graphify-out/
.cursor/

# --- IDE (local settings only) ---
.vscode/
.idea/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp ---
*.log
npm-debug.log*
*.tmp

# --- Internal documentation (private) ---
docs/archive/
docs/changelogs/
docs/superpowers/

# --- Agent metadata (Cursor-local) ---
AGENTS.md

# --- Root markdown: public README only ---
/*.md
!README.md

# --- Extension assets: marketplace uses PNG; SVG stays local ---
images/icon.svg
test/completion_coordinator.test.js
test/config.test.js
test/llm_provider.test.js
test/manifest.test.js
test/provider_errors.test.js
test/query_cache.test.js
test/secret_storage.test.js
README.pdf
images/convert_cartouche_text_to_paths.py
